<!--
  文件说明：呈现 ForgeLink 主导航、概览、设备、点位和实时监控页面。
  责任边界：仅负责绑定与呈现，所有交互控件使用 WPF UI 框架控件。
-->
<ui:FluentWindow x:Class="ForgeLink.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:converters="clr-namespace:ForgeLink.Desktop.Converters"
                 xmlns:controls="clr-namespace:ForgeLink.Desktop.Controls"
                 mc:Ignorable="d"
                 Title="ForgeLink"
                 Width="1360" Height="820" MinWidth="1080" MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource ForgeCanvasBrush}"
                 ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <converters:PageVisibilityConverter x:Key="PageVisibility" />
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="ForgeLink" ShowMinimize="True" ShowMaximize="True" ShowClose="True" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid Margin="16,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,22">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource ForgePrimaryBrush}">
                            <TextBlock Text="F" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ForgeLink" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="工业数据边缘网关" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <ui:Button Content="概览仪表盘" Command="{Binding NavigateCommand}" CommandParameter="Overview" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="设备管理" Command="{Binding NavigateCommand}" CommandParameter="Devices" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="点位管理" Command="{Binding NavigateCommand}" CommandParameter="Points" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="实时数据" Command="{Binding NavigateCommand}" CommandParameter="Realtime" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="历史趋势" Command="{Binding NavigateCommand}" CommandParameter="History" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="数据转发" Command="{Binding NavigateCommand}" CommandParameter="Transport" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="告警与事件" Command="{Binding NavigateCommand}" CommandParameter="Alarms" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="系统设置" Command="{Binding NavigateCommand}" CommandParameter="Settings" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                    </StackPanel>
                    <ui:Card Grid.Row="2" Padding="12">
                        <StackPanel>
                            <TextBlock Text="服务状态" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding ServiceState}" FontWeight="SemiBold" Margin="0,4,0,2" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastRefreshText}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Overview}">
                    <StackPanel Margin="{StaticResource PagePadding}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="概览仪表盘" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="采集服务、设备连接与数据通道的当前状态" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
                            </StackPanel>
                            <ui:Button DockPanel.Dock="Right" Content="立即刷新" Command="{Binding RefreshCommand}" Appearance="Primary" HorizontalAlignment="Right" Padding="18,8" />
                        </DockPanel>
                        <ui:InfoBar Margin="0,20,0,0" Title="服务提示" Message="{Binding ErrorMessage}" Severity="Warning" IsOpen="{Binding HasError}" />
                        <UniformGrid Columns="4" Margin="0,18,0,0">
                            <ui:Card Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock Text="设备在线" Style="{StaticResource MutedTextStyle}" /><TextBlock FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"><Run Text="{Binding OnlineDeviceCount}" /><Run Text=" / " /><Run Text="{Binding DeviceCount}" /></TextBlock></StackPanel></ui:Card>
                            <ui:Card Margin="4,0,8,0" Padding="18"><StackPanel><TextBlock Text="启用点位" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding EnabledPointCount}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></ui:Card>
                            <ui:Card Margin="8,0,4,0" Padding="18"><StackPanel><TextBlock Text="采集成功率" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding SuccessRateText}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{StaticResource ForgeSuccessBrush}" /></StackPanel></ui:Card>
                            <ui:Card Margin="12,0,0,0" Padding="18"><StackPanel><TextBlock Text="实时缓存" Style="{StaticResource MutedTextStyle}" /><TextBlock FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"><Run Text="{Binding RealtimeValueCount}" /><Run Text=" 点" /></TextBlock></StackPanel></ui:Card>
                        </UniformGrid>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ui:Card Grid.Column="0" Padding="20" Margin="0,0,9,0">
                                <StackPanel>
                                    <TextBlock Text="运行概况" FontSize="17" FontWeight="SemiBold" />
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="服务运行时长" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding RuntimeText}" FontSize="18" Margin="0,5,0,0" /></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="历史通道" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding HistoryStatus}" FontSize="18" Margin="0,5,0,0" Foreground="{StaticResource ForgeWarningBrush}" /></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Grid.Column="1" Padding="20" Margin="9,0,0,0">
                                <StackPanel><TextBlock Text="安全边界" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="PLC 写入默认关闭&#10;历史未启用时不保存、不补写&#10;管理接口仅通过本机命名管道开放" Margin="0,14,0,0" LineHeight="26" Foreground="{StaticResource ForgeMutedBrush}" /></StackPanel>
                            </ui:Card>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid Margin="{StaticResource PagePadding}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Devices}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="设备管理" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="配置保存后由 Collector Service 安全热加载" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,18" /></StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:Button Content="新增设备" Command="{Binding NewDeviceCommand}" Appearance="Primary" Margin="0,0,8,0" />
                        <ui:Button Content="编辑" Command="{Binding EditDeviceCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="连接测试" Command="{Binding TestDeviceCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="删除" Command="{Binding RequestDeleteDeviceCommand}" />
                    </StackPanel>
                    <ui:InfoBar Grid.Row="2" Margin="0,0,0,12" Title="配置操作" Message="{Binding OperationMessage}" Severity="Informational" IsOpen="{Binding HasOperationMessage}" />
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:Card Grid.Column="0" Padding="12" Margin="0,0,12,0">
                            <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="*" /><DataGridTextColumn Header="地址" Binding="{Binding Host}" Width="2*" /><DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="*" /><DataGridTextColumn Header="Unit ID" Binding="{Binding UnitId}" Width="*" /><DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="*" /><DataGridTextColumn Header="周期(ms)" Binding="{Binding DefaultScanIntervalMs}" Width="*" /></DataGrid.Columns></DataGrid>
                        </ui:Card>
                        <ui:Card Grid.Column="1" Width="390" Padding="20" Visibility="{Binding IsDeviceEditorOpen, Converter={StaticResource BooleanVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="设备配置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                                    <TextBlock Text="设备名称" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditDeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" />
                                    <TextBlock Text="协议类型" Style="{StaticResource MutedTextStyle}" /><controls:ForgeComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding EditDeviceProtocol}" Margin="0,5,0,12" />
                                    <TextBlock Text="主机地址" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditDeviceHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" />
                                    <TextBlock Text="端口" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditDevicePort, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" />
                                    <TextBlock Text="Modbus Unit ID（0–255）" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditDeviceUnitId, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" />
                                    <TextBlock Text="默认采集周期（毫秒）" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditDeviceIntervalMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="连接超时（毫秒）" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditDeviceConnectionTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="读取超时（毫秒）" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditDeviceReadTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel></Grid>
                                    <ui:ToggleSwitch Content="启用设备" IsChecked="{Binding EditDeviceEnabled}" Margin="0,2,0,18" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ui:Button Content="取消" Command="{Binding CancelDeviceEditCommand}" Margin="0,0,8,0" /><ui:Button Content="保存" Command="{Binding SaveDeviceCommand}" Appearance="Primary" /></StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </ui:Card>
                        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" Padding="14" Visibility="{Binding IsDeviceDeletePending, Converter={StaticResource BooleanVisibility}}">
                            <DockPanel><TextBlock Text="确认删除选中的设备？存在关联点位时服务端会拒绝删除。" VerticalAlignment="Center" /><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ui:Button Content="取消" Command="{Binding CancelDeleteDeviceCommand}" Margin="12,0,8,0" /><ui:Button Content="确认删除" Command="{Binding ConfirmDeleteDeviceCommand}" Appearance="Primary" /></StackPanel></DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Margin="{StaticResource PagePadding}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Points}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="点位管理" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="稳定 ID、工程换算、历史策略、CSV 与写入白名单" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,18" /></StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:Button Content="新增点位" Command="{Binding NewPointCommand}" Appearance="Primary" Margin="0,0,8,0" />
                        <ui:Button Content="编辑" Command="{Binding EditPointCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="删除" Command="{Binding RequestDeletePointCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="导入 CSV" Command="{Binding ImportPointsCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="导出 CSV" Command="{Binding ExportPointsCommand}" />
                    </StackPanel>
                    <ui:InfoBar Grid.Row="2" Margin="0,0,0,12" Title="配置操作" Message="{Binding OperationMessage}" Severity="Informational" IsOpen="{Binding HasOperationMessage}" />
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:Card Grid.Column="0" Padding="12" Margin="0,0,12,0">
                            <DataGrid ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="0" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="*" /><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="*" /><DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="*" /><DataGridTextColumn Header="缩放" Binding="{Binding Scale}" Width="*" /><DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*" /><DataGridTextColumn Header="历史模式" Binding="{Binding HistoryMode}" Width="2*" /><DataGridCheckBoxColumn Header="允许写入" Binding="{Binding AllowWrite}" Width="*" /></DataGrid.Columns></DataGrid>
                        </ui:Card>
                        <ui:Card Grid.Column="1" Width="420" Padding="20" Visibility="{Binding IsPointEditorOpen, Converter={StaticResource BooleanVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="点位配置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                                    <TextBlock Text="所属设备" Style="{StaticResource MutedTextStyle}" /><controls:ForgeComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditPointDeviceId}" Margin="0,5,0,12" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="点位编码" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditPointCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="点位名称" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditPointName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="协议地址" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditPointAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,4" /><TextBlock Text="示例：HR:0、IR:0、COIL:0、40001" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,0,0,12" /></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="数据类型" Style="{StaticResource MutedTextStyle}" /><controls:ForgeComboBox ItemsSource="{Binding PointDataTypes}" SelectedItem="{Binding EditPointDataType}" Margin="0,5,0,12" /></StackPanel></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="缩放" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditPointScale, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel><StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="偏移" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditPointOffset, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel><StackPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock Text="单位" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditPointUnit, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="采集周期（毫秒）" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditPointIntervalMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="死区值" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditPointDeadband, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" /></StackPanel></Grid>
                                    <TextBlock Text="历史记录模式" Style="{StaticResource MutedTextStyle}" /><controls:ForgeComboBox ItemsSource="{Binding HistoryModes}" SelectedItem="{Binding EditPointHistoryMode}" Margin="0,5,0,12" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="寄存器字节序" Style="{StaticResource MutedTextStyle}" /><controls:ForgeComboBox ItemsSource="{Binding ByteOrders}" SelectedItem="{Binding EditPointByteOrder}" Margin="0,5,0,12" /></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="多寄存器字序" Style="{StaticResource MutedTextStyle}" /><controls:ForgeComboBox ItemsSource="{Binding WordOrders}" SelectedItem="{Binding EditPointWordOrder}" Margin="0,5,0,12" /></StackPanel></Grid>
                                    <TextBlock Text="字符串长度（字节，非字符串填 0）" Style="{StaticResource MutedTextStyle}" /><ui:TextBox Text="{Binding EditPointStringLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,18"><ui:ToggleSwitch Content="启用点位" IsChecked="{Binding EditPointEnabled}" Margin="0,0,20,0" /><ui:ToggleSwitch Content="允许写入" IsChecked="{Binding EditPointAllowWrite}" /></StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ui:Button Content="取消" Command="{Binding CancelPointEditCommand}" Margin="0,0,8,0" /><ui:Button Content="保存" Command="{Binding SavePointCommand}" Appearance="Primary" /></StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </ui:Card>
                        <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" Padding="14" Visibility="{Binding IsPointDeletePending, Converter={StaticResource BooleanVisibility}}">
                            <DockPanel><TextBlock Text="确认删除选中的点位？删除后实时缓存会在后续刷新中移除。" VerticalAlignment="Center" /><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ui:Button Content="取消" Command="{Binding CancelDeletePointCommand}" Margin="12,0,8,0" /><ui:Button Content="确认删除" Command="{Binding ConfirmDeletePointCommand}" Appearance="Primary" /></StackPanel></DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Margin="{StaticResource PagePadding}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Realtime}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="实时数据" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="界面每秒批量刷新，不直接消费高频采集事件" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,18" /></StackPanel>
                    <ui:Card Grid.Row="1" Padding="12"><DataGrid ItemsSource="{Binding RealtimeValues}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="点位 ID" Binding="{Binding PointId}" Width="2*" /><DataGridTextColumn Header="工程值" Binding="{Binding EngineeringValue}" Width="*" /><DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*" /><DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="*" /><DataGridTextColumn Header="采集时间(UTC)" Binding="{Binding CollectTimestampUtc}" Width="2*" /><DataGridTextColumn Header="序号" Binding="{Binding SequenceNumber}" Width="*" /></DataGrid.Columns></DataGrid></ui:Card>
                </Grid>

                <StackPanel Margin="{StaticResource PagePadding}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=History}"><TextBlock Text="历史趋势" Style="{StaticResource PageTitleStyle}" /><ui:Card Margin="0,20,0,0" Padding="24"><StackPanel><TextBlock Text="历史存储未启用" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="连接并完整测试 InfluxDB 后才可启用。未启用期间不会保存或补写点位历史，且不会回退到 SQLite。" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel></ui:Card></StackPanel>
                <StackPanel Margin="{StaticResource PagePadding}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Transport}"><TextBlock Text="数据转发" Style="{StaticResource PageTitleStyle}" /><ui:Card Margin="0,20,0,0" Padding="24"><TextBlock Text="REST 与 MQTT 通道将在通道配置通过验证后启用；采集线程不会被外部系统故障阻塞。" TextWrapping="Wrap" /></ui:Card></StackPanel>
                <StackPanel Margin="{StaticResource PagePadding}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Alarms}"><TextBlock Text="告警与事件" Style="{StaticResource PageTitleStyle}" /><ui:Card Margin="0,20,0,0" Padding="24"><TextBlock Text="当前无活动告警。设备离线、采集失败、历史缺口和队列积压将在此统一呈现。" TextWrapping="Wrap" /></ui:Card></StackPanel>
                <StackPanel Margin="{StaticResource PagePadding}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Settings}"><TextBlock Text="系统设置" Style="{StaticResource PageTitleStyle}" /><ui:Card Margin="0,20,0,0" Padding="24"><TextBlock Text="首版设置遵循安全默认值：仅本机管理、PLC 写入关闭、InfluxDB 历史关闭。" TextWrapping="Wrap" /></ui:Card></StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
