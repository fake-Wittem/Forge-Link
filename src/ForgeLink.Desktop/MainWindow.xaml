<!--
  文件说明：呈现 ForgeLink 应用壳层、强类型菜单和当前页面内容。
  责任边界：不包含任何菜单页面业务表单或数据表格。
-->
<ui:FluentWindow x:Class="ForgeLink.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:navigation="clr-namespace:ForgeLink.Desktop.Navigation"
                 Title="ForgeLink" Width="1360" Height="820" MinWidth="1080" MinHeight="680"
                 WindowStartupLocation="CenterScreen" Background="{StaticResource ForgeCanvasBrush}"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="ForgeLink" ShowMinimize="True" ShowMaximize="True" ShowClose="True" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid Margin="16,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,22">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource ForgePrimaryBrush}">
                            <TextBlock Text="F" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ForgeLink" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="工业数据边缘网关" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <ui:Button Content="概览仪表盘" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:AppRoute.Overview}" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="设备管理" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:AppRoute.Devices}" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="点位管理" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:AppRoute.Points}" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="实时数据" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:AppRoute.Realtime}" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="历史趋势" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:AppRoute.History}" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="数据转发" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:AppRoute.Transport}" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="告警与事件" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:AppRoute.Alarms}" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                        <ui:Button Content="系统设置" Command="{Binding NavigateCommand}" CommandParameter="{x:Static navigation:AppRoute.Settings}" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,10" />
                    </StackPanel>
                    <ui:Card Grid.Row="2" Padding="12">
                        <StackPanel>
                            <TextBlock Text="服务状态" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock Text="{Binding Status.ServiceState}" FontWeight="SemiBold" Margin="0,4,0,2" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status.LastRefreshText}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </Border>
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
