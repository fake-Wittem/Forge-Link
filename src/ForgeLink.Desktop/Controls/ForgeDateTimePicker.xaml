<!-- 文件说明：提供日期、小时、分钟和秒的合并选择浮层。责任边界：只维护本地日期时间选择值，不处理 UTC 转换或查询。 -->
<UserControl x:Class="ForgeLink.Desktop.Controls.ForgeDateTimePicker"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:ForgeLink.Desktop.Controls"
             HorizontalContentAlignment="Stretch">
    <Grid>
        <Button x:Name="PickerButton" Style="{StaticResource ForgePickerButtonStyle}" Click="OpenPicker_Click">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ForgePrimaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Text="{Binding DisplayText, ElementName=Root}" Foreground="{StaticResource ForgeTextBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Button>
        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=PickerButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="360" Margin="0,4,0,8" Padding="14" Background="{StaticResource ForgeSurfaceBrush}" BorderBrush="{StaticResource ForgeBorderBrush}" BorderThickness="1" CornerRadius="6">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" /></Border.Effect>
                <StackPanel>
                    <Calendar SelectedDate="{Binding PendingDate, Mode=TwoWay}" DisplayDate="{Binding PendingDate}" IsTodayHighlighted="True" Background="{StaticResource ForgeSurfaceBrush}" Foreground="{StaticResource ForgeTextBrush}" />
                    <TextBlock Text="时间" Foreground="{StaticResource ForgeMutedBrush}" Margin="2,10,2,6" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <controls:ForgeComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding PendingHour, Mode=TwoWay}" Height="32"><controls:ForgeComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0:00}}" TextAlignment="Center" /></DataTemplate></controls:ForgeComboBox.ItemTemplate></controls:ForgeComboBox>
                        <controls:ForgeComboBox Grid.Column="2" ItemsSource="{Binding Minutes}" SelectedItem="{Binding PendingMinute, Mode=TwoWay}" Height="32"><controls:ForgeComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0:00}}" TextAlignment="Center" /></DataTemplate></controls:ForgeComboBox.ItemTemplate></controls:ForgeComboBox>
                        <controls:ForgeComboBox Grid.Column="4" ItemsSource="{Binding Seconds}" SelectedItem="{Binding PendingSecond, Mode=TwoWay}" Height="32"><controls:ForgeComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0:00}}" TextAlignment="Center" /></DataTemplate></controls:ForgeComboBox.ItemTemplate></controls:ForgeComboBox>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <ui:Button Content="现在" HorizontalAlignment="Left" Click="UseNow_Click" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ui:Button Content="取消" Margin="0,0,8,0" Click="Cancel_Click" /><ui:Button Content="确定" Appearance="Primary" Click="Apply_Click" /></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
