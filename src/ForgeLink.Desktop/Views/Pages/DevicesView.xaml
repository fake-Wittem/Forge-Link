<!-- 文件说明：设备管理独立页面。责任边界：只呈现设备列表、命令和设备编辑器。 -->
<UserControl x:Class="ForgeLink.Desktop.Views.Pages.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:editors="clr-namespace:ForgeLink.Desktop.Views.Editors">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="设备管理" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="配置保存后由 Collector Service 安全热加载" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,18" /></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><ui:Button Content="新增设备" Command="{Binding NewDeviceCommand}" Appearance="Primary" Margin="0,0,8,0" /><ui:Button Content="连接测试" Command="{Binding TestDeviceCommand}" Margin="0,0,8,0" /><ui:Button Content="批量删除" Command="{Binding RequestDeleteDeviceCommand}" IsEnabled="{Binding HasCheckedDevices}" Style="{StaticResource ForgeDangerButtonStyle}" /></StackPanel>
        <ui:InfoBar Grid.Row="2" Margin="0,0,0,12" Title="配置操作" Message="{Binding Messages.Message}" Severity="Informational" IsOpen="{Binding Messages.HasMessage}" />
        <Grid Grid.Row="3" VerticalAlignment="Stretch">
            <Border Style="{StaticResource ForgeTableSurfaceStyle}">
                <DataGrid ItemsSource="{Binding DeviceRows}" SelectedItem="{Binding SelectedDeviceRow}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="44"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="设备名称" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Command="{Binding DataContext.EditDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Item}" Style="{StaticResource ForgeTableLinkButtonStyle}" ToolTip="{Binding Item.Name}"><TextBlock Text="{Binding Item.Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Stretch" /></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="协议" Binding="{Binding Item.Protocol}" ElementStyle="{StaticResource ForgeTableTextStyle}" Width="*" />
                        <DataGridTextColumn Header="地址" Binding="{Binding Item.Host}" ElementStyle="{StaticResource ForgeTableTextStyle}" Width="2*" />
                        <DataGridTextColumn Header="端口" Binding="{Binding Item.Port}" ElementStyle="{StaticResource ForgeTableTextStyle}" Width="*" />
                        <DataGridTextColumn Header="Unit ID" Binding="{Binding Item.UnitId}" ElementStyle="{StaticResource ForgeTableTextStyle}" Width="*" />
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Item.IsEnabled}" ElementStyle="{StaticResource ForgeTableSwitchStyle}" Width="*" />
                        <DataGridTextColumn Header="周期 (ms)" Binding="{Binding Item.DefaultScanIntervalMs}" ElementStyle="{StaticResource ForgeTableTextStyle}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border VerticalAlignment="Bottom" Style="{StaticResource ForgeConfirmationBarStyle}" Visibility="{Binding IsDeletePending, Converter={StaticResource BooleanVisibility}}"><DockPanel><TextBlock VerticalAlignment="Center"><Run Text="确认删除已勾选的 " /><Run Text="{Binding CheckedDeviceCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" 台设备？存在关联点位时服务端会拒绝对应设备。" /></TextBlock><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ui:Button Content="取消" Command="{Binding CancelDeleteDeviceCommand}" Margin="12,0,8,0" /><ui:Button Content="确认批量删除" Command="{Binding ConfirmDeleteDeviceCommand}" Style="{StaticResource ForgeDangerButtonStyle}" /></StackPanel></DockPanel></Border>
        </Grid>
        <Grid Grid.RowSpan="4" Margin="-28" Style="{StaticResource ForgeModalOverlayStyle}" Visibility="{Binding Editor.IsOpen, Converter={StaticResource BooleanVisibility}}" MouseLeftButtonDown="ModalOverlay_MouseLeftButtonDown">
            <editors:DeviceEditorView HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="640" Margin="32" />
        </Grid>
    </Grid>
</UserControl>
