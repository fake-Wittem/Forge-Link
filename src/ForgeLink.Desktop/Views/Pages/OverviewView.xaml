<!-- 文件说明：概览仪表盘页面。责任边界：仅绑定 OverviewViewModel 和共享状态。 -->
<UserControl x:Class="ForgeLink.Desktop.Views.Pages.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left"><TextBlock Text="概览仪表盘" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="采集服务、设备连接与数据通道的当前状态" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" /></StackPanel>
                <ui:Button DockPanel.Dock="Right" Content="立即刷新" Command="{Binding RefreshCommand}" Appearance="Primary" HorizontalAlignment="Right" Padding="18,8" />
            </DockPanel>
            <ui:InfoBar Margin="0,20,0,0" Title="服务提示" Message="{Binding Status.ErrorMessage}" Severity="Warning" IsOpen="{Binding Status.HasError}" />
            <UniformGrid Columns="4" Margin="0,18,0,0">
                <ui:Card Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock Text="设备在线" Style="{StaticResource MutedTextStyle}" /><TextBlock FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"><Run Text="{Binding Status.OnlineDeviceCount}" /><Run Text=" / " /><Run Text="{Binding Status.DeviceCount}" /></TextBlock></StackPanel></ui:Card>
                <ui:Card Margin="4,0,8,0" Padding="18"><StackPanel><TextBlock Text="启用点位" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding Status.EnabledPointCount}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></ui:Card>
                <ui:Card Margin="8,0,4,0" Padding="18"><StackPanel><TextBlock Text="采集成功率" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding Status.SuccessRateText}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{StaticResource ForgeSuccessBrush}" /></StackPanel></ui:Card>
                <ui:Card Margin="12,0,0,0" Padding="18"><StackPanel><TextBlock Text="实时缓存" Style="{StaticResource MutedTextStyle}" /><TextBlock FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"><Run Text="{Binding Status.RealtimeValueCount}" /><Run Text=" 点" /></TextBlock></StackPanel></ui:Card>
            </UniformGrid>
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ui:Card Grid.Column="0" Padding="20" Margin="0,0,9,0"><StackPanel><TextBlock Text="运行概况" FontSize="17" FontWeight="SemiBold" /><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="服务运行时长" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding Status.RuntimeText}" FontSize="18" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="历史通道" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding Status.HistoryStatus}" FontSize="18" Margin="0,5,0,0" Foreground="{StaticResource ForgeWarningBrush}" /></StackPanel></Grid></StackPanel></ui:Card>
                <ui:Card Grid.Column="1" Padding="20" Margin="9,0,0,0"><StackPanel><TextBlock Text="安全边界" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="PLC 写入默认关闭&#10;历史未启用时不保存、不补写&#10;管理接口仅通过本机命名管道开放" Margin="0,14,0,0" LineHeight="26" Foreground="{StaticResource ForgeMutedBrush}" /></StackPanel></ui:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
